# Cascade UI — Editor Configuration
# These rules are enforced at build time via EnforceCodeStyleInBuild.

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]

# Naming: private fields — no underscore prefix
dotnet_naming_rule.private_fields_no_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_no_underscore.style = camel_case_style
dotnet_naming_rule.private_fields_no_underscore.severity = error

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.camel_case_style.capitalization = camel_case
dotnet_naming_style.camel_case_style.required_prefix =

# Naming: public members — PascalCase
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal_case_style
dotnet_naming_rule.public_members_pascal.severity = error

dotnet_naming_symbols.public_members.applicable_kinds = property, method, event, delegate, class, struct, interface, enum
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal, protected, protected_internal

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Naming: parameters and locals — camelCase
dotnet_naming_rule.locals_camel.symbols = locals_and_params
dotnet_naming_rule.locals_camel.style = camel_case_style
dotnet_naming_rule.locals_camel.severity = error

dotnet_naming_symbols.locals_and_params.applicable_kinds = parameter, local

# Braces: always required
csharp_prefer_braces = true:error

# Guard clauses: prefer early return
dotnet_diagnostic.IDE0046.severity = suggestion

# Prefer pattern matching
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Expression bodies: allow but don't force
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

# var usage: prefer explicit types for built-in types
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Namespace: file-scoped
csharp_style_namespace_declarations = file_scoped:error

# Using directives: inside namespace = false (top of file)
csharp_using_directive_placement = outside_namespace:error

# Sort usings: System first
dotnet_sort_system_directives_first = true

# Qualifier: do not require 'this.' prefix
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# Null checking
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# ── Code Analysis suppressions ─────────────────────────────────────────
# Phase 1 type signatures: suppress rules incompatible with API conventions.

# Events use Action<T> per framework spec, not EventHandler<T>
dotnet_diagnostic.CA1003.severity = none

# Static members on generic types are intentional (AsyncData<T> factories)
dotnet_diagnostic.CA1000.severity = none

# Use properties where appropriate — method design is intentional
dotnet_diagnostic.CA1024.severity = none

# Custom exceptions do not need all four standard constructors
dotnet_diagnostic.CA1032.severity = none

# Type-safe enum pattern: sealed class with private ctor + static members
dotnet_diagnostic.CA1052.severity = none

# URI parameters/properties are strings in interop APIs
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

# Phase 1: properties throw NotImplementedException (type signatures only)
dotnet_diagnostic.CA1065.severity = none

# Null parameter validation — Phase 1 stubs do not validate yet
dotnet_diagnostic.CA1062.severity = none

# Type naming rules — UndoStack, etc. are correct names
dotnet_diagnostic.CA1711.severity = none

# Naming case conflicts: fluent API methods match field names by design
dotnet_diagnostic.CA1708.severity = none

# Enum member naming (e.g. TooltipDelay.Long) — not type names
dotnet_diagnostic.CA1720.severity = none

# Explicit default initialization is intentional for clarity
dotnet_diagnostic.CA1805.severity = none

# Phase 1 value types will implement Equals when fully implemented
dotnet_diagnostic.CA1815.severity = none

# Array properties are intentional in configuration types
dotnet_diagnostic.CA1819.severity = none

# Implicit operator alternatives not required for LocKey design
dotnet_diagnostic.CA2225.severity = none

# Win32 interop: general catch blocks are required to keep message loop alive
dotnet_diagnostic.CA1031.severity = none

# Win32 interop: CF_HTML format uses invariant byte offsets, not locale
dotnet_diagnostic.CA1305.severity = none

# Sealed return types: concrete return type is intentional for interop helpers
dotnet_diagnostic.CA1859.severity = none

# Win32 message loop: ConfigureAwait not applicable on UI thread dispatch
dotnet_diagnostic.CA2007.severity = none

# Async: prefer await over .Result/.Wait()
# (enforced by code review — no built-in analyzer rule for this)

[*.{json,xml,csproj,props,targets}]
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
