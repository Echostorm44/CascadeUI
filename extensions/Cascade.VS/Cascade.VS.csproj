<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Cascade.VS</RootNamespace>
    <!-- VS extension properties -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- These would be added when VS SDK is available:
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.8" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.8" />
    -->
    <ProjectReference Include="..\..\src\Cascade.IDE.Shared\Cascade.IDE.Shared.csproj" />
  </ItemGroup>
</Project>
