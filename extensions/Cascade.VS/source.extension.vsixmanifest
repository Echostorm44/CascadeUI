<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Cascade.VS" Version="1.0.0" Language="en-US" Publisher="Cascade UI" />
    <DisplayName>Cascade UI for Visual Studio</DisplayName>
    <Description>First-class IDE support for Cascade UI — live preview, inspector, hot reload, and signal annotations.</Description>
    <MoreInfo>https://github.com/AnnaSapphireMedia/CascadeUI</MoreInfo>
    <License>LICENSE.md</License>
    <Icon>Resources/icon.png</Icon>
    <Tags>cascade, ui, framework, preview, hot-reload</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.8,)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[17.8,)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.8,)" />
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.8,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
</PackageManifest>
