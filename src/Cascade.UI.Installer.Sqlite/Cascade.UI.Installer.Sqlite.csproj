<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cascade.UI.Installer.Sqlite</RootNamespace>
    <Description>SQLite install-time database provider for Cascade UI installers (ctx.Sql.For&lt;SqliteInstallerProvider&gt;()).</Description>
    <!-- NU1903: the transitive SQLitePCLRaw native SQLite bundle (GHSA-2m69-gcr7-jv3q) has no fixed
         release available yet. This is an OPT-IN provider; the same native lib is pulled by any app
         that uses SQLite. REVISIT and bump SQLitePCLRaw once a fixed version ships. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cascade.UI.Installer\Cascade.UI.Installer.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>
</Project>
