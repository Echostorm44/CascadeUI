<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cascade.UI.McpBridge</RootNamespace>
    <AssemblyName>cascade-mcp</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <Description>Cascade UI MCP bridge — stdio MCP proxy to running Cascade apps</Description>
    <!-- CLI help text is correctly hardcoded — not localizable -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The bridge always advertises the DevTools tool surface, including in
         the Release AOT publish. It is a forwarder: the connected live
         instance enforces its own DevTools gating, and with no instance the
         tools return structured "no live instance" errors. Without this
         define the published bridge would hide every DebugOnly tool. -->
    <DefineConstants>$(DefineConstants);CASCADE_DEVTOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cascade.UI\Cascade.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cascade.UI.McpBridge.Tests" />
  </ItemGroup>

</Project>
