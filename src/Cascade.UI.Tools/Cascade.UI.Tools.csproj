<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cascade.UI.Tools</RootNamespace>
    <AssemblyName>cascade</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cascade</ToolCommandName>
    <Description>Cascade UI CLI tool — cascade watch, cascade doctor, cascade new</Description>
    <PackageId>Echostorm.Cascade.UI.Tools</PackageId>
    <!-- CLI help text is correctly hardcoded — not localizable -->
    <!-- CS0619: EmitBaseline.CreateInitialBaseline overloads deprecated without replacement in .NET 10 Roslyn -->
    <NoWarn>$(NoWarn);CA1303;CS0619</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cascade.UI\Cascade.UI.csproj" />
    <ProjectReference Include="..\Cascade.UI.Updater.Core\Cascade.UI.Updater.Core.csproj" />
    <!-- Hosts the stdio MCP bridge (HeadlessMcpServer) for `cascade mcp serve`. -->
    <ProjectReference Include="..\Cascade.UI.McpBridge\Cascade.UI.McpBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cascade.UI.Tests" />
  </ItemGroup>

</Project>
