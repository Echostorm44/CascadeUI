<Project>
  <!-- Import root Directory.Build.props first -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <!-- Allow underscores in test method names (standard convention) -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Test classes must be public for TUnit discovery -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>
</Project>
